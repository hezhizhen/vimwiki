# Travel thought files

Execute (Open an empty wiki after the editor's filetype detection):
  edit $HOME/testwiki/filetype_detection.wiki
  AssertEqual 'vimwiki', &filetype
  AssertEqual 2, exists(':Vimwiki2HTML')
  AssertEqual 2, exists(':VimwikiRebuildTags')
  call DeleteFile('%')

Execute (Load wiki commands after an invalid filetype undo command):
  enew
  let b:undo_ftplugin = 0
  call vimwiki#u#ft_set()
  AssertEqual 2, exists(':Vimwiki2HTML')

Execute (Run valid filetype cleanup when switching to Vimwiki):
  let g:vimwiki_test_undo = 0
  let b:undo_ftplugin = 'let g:vimwiki_test_undo = 1'
  call vimwiki#u#ft_set()
  AssertEqual 1, g:vimwiki_test_undo
  AssertEqual 2, exists(':Vimwiki2HTML')
  unlet g:vimwiki_test_undo

Execute (Detect a wiki extension after renaming an unnamed buffer):
  enew
  file filetype_renamed.md
  AssertEqual 'vimwiki', &filetype
  AssertEqual 2, exists(':VimwikiRebuildTags')
  bwipeout!

Execute (Reinitialize the wiki list while a temporary wiki buffer stays open):
  edit /tmp/vimwiki_cached_index.md
  Assert vimwiki#vars#get_bufferlocal('wiki_nr') >= 4
  call vimwiki#vars#init()
  AssertEqual -1, vimwiki#vars#get_bufferlocal('wiki_nr')
  AssertEqual 'default', vimwiki#vars#get_wikilocal('syntax')
  bwipeout!

Execute (Recompute hidden buffer wiki indices from their own paths after reinitialization):
  edit $HOME/testwiki/cached_default.wiki
  let default_buffer = bufnr('')
  AssertEqual 0, vimwiki#vars#get_bufferlocal('wiki_nr')
  edit $HOME/testmarkdown/cached_markdown.md
  let markdown_buffer = bufnr('')
  AssertEqual 1, vimwiki#vars#get_bufferlocal('wiki_nr')
  call vimwiki#vars#init()
  let directory = getcwd()
  try
    lcd $HOME/testwiki
    AssertEqual 0, vimwiki#vars#get_bufferlocal('wiki_nr', default_buffer)
    AssertEqual 1, vimwiki#vars#get_bufferlocal('wiki_nr')
    AssertEqual markdown_buffer, bufnr('')
    enew
    let current_buffer = bufnr('')
    call vimwiki#vars#init()
    AssertEqual 0, vimwiki#vars#get_bufferlocal('wiki_nr', bufname(default_buffer))
    AssertEqual 1, vimwiki#vars#get_bufferlocal('wiki_nr', bufname(markdown_buffer))
    AssertEqual -1, vimwiki#vars#get_bufferlocal('wiki_nr')
    AssertEqual current_buffer, bufnr('')
  finally
    execute 'lcd ' . fnameescape(directory)
    execute 'bwipeout! ' . default_buffer
    execute 'bwipeout! ' . markdown_buffer
  endtry

Given (Void for Accessing other files within vimwiki #979 {{{1):


Do (At Index: Create and goto pythonfile):
  :VimwikiIndex 2\<Cr>
  Opyfile.py\<Esc>\<Cr>\<Cr>
  " See #950 appending to every file: https://github.com/vimwiki/vimwiki/issues/950
  :AssertEqual 'pyfile.py.md', expand('%:t')\<CR>
  :AssertEqual 'python', &ft\<CR>
  :Log "Clean pyfile"\<Cr>
  dd
  :VimwikiIndex 2\<Cr>
  " :call DeleteFile('pyfile.py')\<Cr>


Do (At Index: Create and goto markdownfile):
  :VimwikiIndex 2\<Cr>
  Omdfile.md\<Esc>\<Cr>\<Cr>
  :AssertEqual 'mdfile.md', expand('%:t')\<CR>
  :AssertEqual 'vimwiki', &ft\<CR>
  :Log "Clean mdfile"\<Cr>
  :VimwikiIndex 2\<Cr>
  dd
  " :call DeleteFile('mdfile.md')\<Cr>

